<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://example.org/dma_musicoset.owl"
         xmlns="http://example.org/dma_musicoset.owl#">

<owl:Ontology rdf:about="http://example.org/dma_musicoset.owl"/>

<owl:ObjectProperty rdf:about="#hasRecording">
  <rdfs:domain rdf:resource="#Track"/>
  <rdfs:range rdf:resource="#Recording"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasRelease">
  <rdfs:domain rdf:resource="#Track"/>
  <rdfs:range rdf:resource="#Release"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasAlbum">
  <rdfs:domain rdf:resource="#Track"/>
  <rdfs:range rdf:resource="#Album"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasArtist">
  <rdfs:domain rdf:resource="#Track"/>
  <rdfs:range rdf:resource="#Artist"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasPerformer">
  <rdfs:domain rdf:resource="#Track"/>
  <rdfs:range rdf:resource="#Performer"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasComposer">
  <rdfs:domain rdf:resource="#Track"/>
  <rdfs:range rdf:resource="#Composer"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasGenre">
  <rdfs:domain rdf:resource="#Track"/>
  <rdfs:range rdf:resource="#Genre"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasSubGenre">
  <rdfs:domain rdf:resource="#Track"/>
  <rdfs:range rdf:resource="#SubGenre"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasInstrument">
  <rdfs:domain rdf:resource="#Track"/>
  <rdfs:range rdf:resource="#Instrument"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasLanguage">
  <rdfs:domain rdf:resource="#Track"/>
  <rdfs:range rdf:resource="#Language"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasLabel">
  <rdfs:domain rdf:resource="#Release"/>
  <rdfs:range rdf:resource="#Label"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasCountry">
  <rdfs:domain rdf:resource="#Artist"/>
  <rdfs:range rdf:resource="#Country"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasMood">
  <rdfs:domain rdf:resource="#Track"/>
  <rdfs:range rdf:resource="#Mood"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#inCollection">
  <rdfs:domain rdf:resource="#Track"/>
  <rdfs:range rdf:resource="#Collection"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#trackTitle">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Track"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#trackId">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Track"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#durationSeconds">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Track"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#releaseYear">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Release"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#releaseTitle">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Release"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#artistName">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Artist"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#entityName">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#genreName">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Genre"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#instrumentName">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Instrument"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#languageName">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Language"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#moodName">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Mood"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#labelName">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Label"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#collectionName">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Collection"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#Track">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasArtist"/>
      <owl:someValuesFrom rdf:resource="#Artist"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasGenre"/>
      <owl:someValuesFrom rdf:resource="#Genre"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#trackTitle"/>
      <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#Recording">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Release">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#releaseTitle"/>
      <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#Album">
  <rdfs:subClassOf rdf:resource="#Release"/>
</owl:Class>

<owl:Class rdf:about="#Single">
  <rdfs:subClassOf rdf:resource="#Release"/>
</owl:Class>

<owl:Class rdf:about="#Person">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Group">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Artist">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#artistName"/>
      <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#Composer">
  <rdfs:subClassOf rdf:resource="#Person"/>
</owl:Class>

<owl:Class rdf:about="#Performer">
  <rdfs:subClassOf rdf:resource="#Artist"/>
</owl:Class>

<owl:Class rdf:about="#Genre">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#SubGenre">
  <rdfs:subClassOf rdf:resource="#Genre"/>
</owl:Class>

<owl:Class rdf:about="#Instrument">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Language">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Label">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Country">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Mood">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Collection">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:NamedIndividual rdf:about="#track_track_unknown">
  <rdf:type rdf:resource="#Track"/>
  <trackId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">track_unknown</trackId>
</owl:NamedIndividual>


</rdf:RDF>
